---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";
import aboutImage from "@assets/me/me.webp";

type Props = Omit<AboutProps, "image"> & Pick<HeroProps, "name">;

const { description, name, email } = Astro.props;
---

<Section text="About Me" href="about">
  <div class="flex gap-12 md:gap-8 flex-col items-center md:flex-row">
    <p class="text-neutral w-auto text-base md:pr-5">
      {
        description.map((paragraph, pIndex) => (
          <span class="block mb-4">
            {paragraph.split(" ").map((word, wIndex) => (
              <span
                class="cascade-word"
                style={`--i: ${pIndex * 10 + wIndex};`}
              >
                {word}&nbsp;
              </span>
            ))}
          </span>
        ))
      }
    </p>
    <div
      transition:animate="slide"
      class="w-64 h-80 bg-white p-4 flex-shrink-0 rotate-[5deg] md:rotate-[7deg]"
    >
      <Image
        class="object-cover"
        src={aboutImage}
        width="260"
        height="260"
        alt={name}
      />
    </div>
  </div>
  <br />
  <br />
  <a
    class="text-sm py-5 px-8 text-white inline-block font-bold leading-5 bg-primary rounded-full"
    href={`mailto:${email}`}>Get in Touch</a
  >
</Section>
