---
import Section from "./Section.astro";
import type { EducationProps } from "@types";
import { Image } from "astro:assets";

import unirLogo from "@assets/education/unir.png";
import eciLogo from "@assets/education/eci.png";
import senaLogo from "@assets/education/sena.svg";
import googleLogo from "@assets/education/google.webp";
import metaLogo from "@assets/education/meta.png";
import uciLogo from "@assets/education/uci.webp";
import deeplearningaiLogo from "@assets/education/deeplearningai.png";
import harvardxLogo from "@assets/education/harvardx.png";

interface Props {
  education: Omit<EducationProps, "logo">[];
}

const { education } = Astro.props;

const logos = [
  unirLogo,
  eciLogo,
  senaLogo,
  googleLogo,
  googleLogo, // Google is repeated
  metaLogo,
  uciLogo,
  deeplearningaiLogo,
  harvardxLogo,
];

const educationWithLogos = education.map((item, index) => ({
  ...item,
  logo: logos[index],
}));
---

<Section text="Education" href="education">
  {
    educationWithLogos.map(
      (
        {
          institution,
          instructor,
          degree,
          certificate,
          startDate,
          endDate,
          dissertation,
          dissertationLink,
          courses,
          logo,
          educationType,
        },
        pIndex,
      ) => (
        <div class="mb-10">
          <span class="relative flex justify-center mb-5">
            <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-transparent bg-gradient-to-r from-transparent via-gray-500 to-transparent opacity-75" />
          </span>
          <div class="flex gap-5">
            <div
              transition:animate="slide"
              class="w-24 h-24 flex-shrink-0 rounded-lg overflow-hidden bg-white flex items-center justify-center p-2"
            >
              <Image
                class="w-full h-full object-contain"
                src={logo}
                alt={institution}
                width="80"
                height="80"
              />
            </div>
            <div class="flex-1">
              <h3
                transition:animate="slide"
                class="text-2xl font-serif font-semibold text-white mb-1.5"
              >
                {educationType === "Informal" && instructor ? (
                  <>
                    {instructor}{" "}
                    <span class="text-white/70 text-xl italic">
                      {" "}
                      at {institution}
                    </span>
                    {certificate ? (
                      <>
                        <span class="text-orange/70 text-xl italic">
                          <a
                            href={certificate}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-primary inline-block after:relative after:bottom-[-4px] after:content-[url(/external.svg)]"
                          ></a>
                        </span>
                      </>
                    ) : null}
                  </>
                ) : (
                  institution
                )}
              </h3>
              <div class="flex flex-col items-start pb-5">
                <h4
                  transition:animate="slide"
                  class="text-2xl font-serif text-primary font-medium mb-0.5"
                >
                  {degree.split(" ").length > 1 ? (
                    <>
                      <span class="text-rose-500">{degree.split(" ")[0]}</span>{" "}
                      {degree.split(" ").slice(1).join(" ")}
                    </>
                  ) : (
                    <>
                      <span class="text-rose-500">{degree.slice(0, 3)}</span>
                      {degree.slice(3)}
                    </>
                  )}
                </h4>
                <span
                  transition:animate="slide"
                  class="font-bold text-sm text-white/70 pb-[2px]"
                >
                  {startDate} — {endDate}
                </span>
              </div>
            </div>
          </div>

          {educationType === "Formal" && dissertation && (
            <div class="mb-4">
              <p class="text-lg font-bold text-white mb-2">
                {"Dissertation Title: ".split(" ").map((word, wIndex) => (
                  <span
                    class="cascade-word"
                    style={`--i: ${pIndex * 10 + wIndex};`}
                  >
                    {word}&nbsp;
                  </span>
                ))}
              </p>
              {dissertationLink ? (
                <a
                  href={dissertationLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white/70 hover:text-orange-400 transition-colors"
                >
                  {dissertation.split(" ").map((word, wIndex) => (
                    <span
                      class="cascade-word"
                      style={`--i: ${pIndex * 10 + 5 + wIndex};`}
                    >
                      {word}&nbsp;
                    </span>
                  ))}
                </a>
              ) : (
                <p class="text-white/70">
                  {dissertation.split(" ").map((word, wIndex) => (
                    <span
                      class="cascade-word"
                      style={`--i: ${pIndex * 10 + 5 + wIndex};`}
                    >
                      {word}&nbsp;
                    </span>
                  ))}
                </p>
              )}
            </div>
          )}

          {educationType === "Informal" && courses && courses.length > 0 && (
            <div>
              <h5 class="text-lg font-medium text-white mb-2">
                {"Courses".split(" ").map((word, wIndex) => (
                  <span
                    class="cascade-word"
                    style={`--i: ${pIndex * 10 + wIndex};`}
                  >
                    {word}&nbsp;
                  </span>
                ))}
              </h5>
              <ul class="list-none grid grid-cols-1 md:grid-cols-2 gap-2">
                {courses.map((course, cIndex) => (
                  <li>
                    <a
                      href={course.certificate}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white/70 hover:text-orange-400 transition-colors flex items-center"
                    >
                      <span class="mr-2">🔹</span>
                      {course.name.split(" ").map((word, wIndex) => (
                        <span
                          class="cascade-word"
                          style={`--i: ${pIndex * 10 + cIndex * 5 + wIndex};`}
                        >
                          {word}&nbsp;
                        </span>
                      ))}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ),
    )
  }
</Section>
